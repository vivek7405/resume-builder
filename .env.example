# webjs environment variables
# Copy to .env and fill in your values: cp .env.example .env
#
# Opinionated defaults: set these and the framework auto-configures.

# ── Server ──────────────────────────────────────────────────────────
PORT=8080

# ── Auth (required for authentication) ──────────────────────────────
# Generate: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── OAuth providers (optional - enable the ones you need) ───────────
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# ── Redis (production scaling) ──────────────────────────────────────
# Set this and cache, sessions, rate limiting, and pub/sub all
# automatically use Redis. Without it, everything uses in-memory
# defaults (great for development).
# REDIS_URL=redis://localhost:6379

# ── Database ────────────────────────────────────────────────────────
# Used by Drizzle. SQLite for dev, PostgreSQL for production (--db postgres).
DATABASE_URL=file:./db/dev.db

# ── AI samples (optional) ───────────────────────────────────────────
# "Generate a sample resume" asks Claude for a complete fictional resume.
# Either variable enables it: an API key, or a Claude subscription bearer
# token in ANTHROPIC_AUTH_TOKEN. With neither, a built-in sample is used.
# FOLIO_AI=off forces the built-in sample even when a credential is set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
